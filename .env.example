# 环境变量示例（复制为 .env 后修改）

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug

# 热搜存储（每日搜索词）：需记录/查看搜索趋势时配置，默认走内存（重启后丢失）。
TURSO_URL=
TURSO_AUTH_TOKEN=

# 频道清单解密密钥（64 位 hex），用于解密频道配置。
CHANNEL_KEY=

# 小程序登录（2026-08-28）：/api/mp/login 用 code2session 换 openid → 签发 Bearer token
# 微信公众平台 → 开发 → 开发设置 获取
MP_APPID=
MP_SECRET=