# PanHub 环境变量示例（复制为 .env 后按需修改）
#
# 用法：
#   cp .env.example .env
#
# 说明：
#   - 主站（panhub.shenzjd.com）固定下发频道配置，部署方【无需】配置任何
#     CHANNELS_* 变量；服务端写死全流量（微信关注强制 + 限流），无需开关。
#   - 所有变量均可选；未配置时服务使用内置默认值（搜索可用、可运行）。

# ---------- 必填：数据存储与频道解密 ----------
# Turso 数据库连接（热搜 + 频道配置共用；与 migrate/sync 脚本同源）
TURSO_URL=libsql://your-db.your-org.turso.io
# Turso 认证 Token（控制台生成）
TURSO_AUTH_TOKEN=

# 频道清单加密密钥（64 位 hex / 32 字节）。必须与同步脚本一致：
#   生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHANNEL_KEY=

# ---------- 可选 ----------
# 日志级别：debug | info | warn | error
# LOG_LEVEL=info

# 远程频道配置源（缺省内置主站 https://panhub.shenzjd.com/api/channels，无需配置）
# CHANNELS_REMOTE_URL=
# 拉取远程配置的鉴权标识（可选）
# CHANNELS_API_KEY=

# 搜索限流（每次请求数 / 窗口 ms）
# SEARCH_RATE_LIMIT=20
# SEARCH_WINDOW_MS=60000

# IP 黑名单拦截（1=拦截生效，0=仅记录）
# BOT_DEFENSE_ENFORCE=1

# 管理后台
# SEARCH_PASSWORD=
# ADMIN_ORIGIN_ALLOWLIST=
# ADMIN_FORCE_READ_ORIGIN=1
# MP_CLIENT_SECRET=