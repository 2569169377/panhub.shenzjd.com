/* 主题色覆盖 */
page {
  --td-brand-color: #0f766e;
  --td-brand-color-active: #0d9488;
  --td-brand-color-disabled: #99f6e4;
  --td-brand-color-focus: #99f6e4;
  --td-brand-color-light: #ccfbf1;
  --td-text-color-primary: #1f2937;
  --td-text-color-secondary: #6b7280;
  --td-bg-color-container: #ffffff;
  --td-bg-color-page: #f5f7f9;
  --td-border-radius: 12px;
  background: #f5f7f9;
  color: #1f2937;
  font-size: 28rpx;
}

view, text {
  box-sizing: border-box;
}
