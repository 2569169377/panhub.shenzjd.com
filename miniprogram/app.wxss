/* =========================================
   PanHub 微信小程序 · 全局样式（微信官方色调）
   设计稿 375 宽 → rpx（1px = 2rpx）
   主色 #07C160 / 背景 #F7F7F7 / 红 #FA5151
   ========================================= */

page {
  --brand: #07C160;
  --brand-deep: #06AD56;
  --brand-dark: #05A34F;
  --brand-light: #E8F8EF;
  --bg-page: #F7F7F7;
  --card-bg: #FFFFFF;
  --text-main: #111827;
  --text-sub: #6B7280;
  --text-weak: #999999;
  --danger: #FA5151;
  --line: #E5E5E5;
  --surface-light: #F5F5F5;
  --radius-card: 32rpx;
  --radius-ctrl: 24rpx;

  background: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: none;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.page-content {
  padding: 32rpx 40rpx calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- 标题 ---------- */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-hint {
  font-size: 20rpx;
  color: var(--text-weak);
}
