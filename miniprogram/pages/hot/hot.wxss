/* ============ 热搜趋势页（微信绿重构） ============ */

.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.hot-content {
  padding: 32rpx 40rpx calc(240rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ---------- 搜索日历卡 ---------- */
.cal-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-hint {
  font-size: 20rpx;
  color: #999999;
}

.cal-scroll {
  width: 100%;
  white-space: nowrap;
}

.cal-row {
  display: inline-flex;
  gap: 12rpx;
}

.cal-cell {
  width: 108rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.cal-cell--today {
  background: #07c160;
  border-color: #07c160;
  box-shadow: 0 8rpx 16rpx rgba(7, 193, 96, 0.35);
}

.cal-cell--hover {
  opacity: 0.8;
}

.cal-cell__day {
  font-size: 26rpx;
  color: #374151;
}

.cal-cell__day--today {
  color: #ffffff;
  font-weight: 600;
}

.cal-cell__count {
  font-size: 20rpx;
  color: #999999;
}

.cal-cell__count--today {
  color: #ffffff;
}

/* ---------- 通用卡内加载 / 空态 ---------- */
.card-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.card-loading__spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.card-empty {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.card-empty__text {
  font-size: 24rpx;
  color: #999999;
}

/* ---------- 今日 TOP ---------- */
.top-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.top-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-more {
  font-size: 24rpx;
  font-weight: 500;
  color: #07c160;
}

.rank-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.rank-row--hover {
  opacity: 0.75;
}

.rank-row__left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.rank-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.rank-box--hot {
  background: #fa5151;
  color: #ffffff;
  font-weight: 700;
}

.rank-box--normal {
  background: #f5f5f5;
  color: #888888;
  font-weight: 500;
}

.rank-row__term {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.rank-row__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-row__count {
  font-size: 22rpx;
  color: #999999;
}

.rank-row__flame {
  width: 20rpx;
  height: 20rpx;
}

.rank-row__flame--weak {
  opacity: 0.5;
}

.rank-row__pct {
  font-size: 22rpx;
  font-weight: 600;
  color: #fa5151;
}

/* ---------- 飙升榜 ---------- */
.soar-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.soar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.soar-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.soar-title__icon {
  width: 32rpx;
  height: 32rpx;
}

.soar-more {
  font-size: 24rpx;
  font-weight: 500;
  color: #07c160;
}

.soar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-radius: 20rpx;
}

.soar-row--top {
  background: #fde8e8;
}

.soar-row__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.soar-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.soar-arrow--top {
  background: #fecaca;
}

.soar-arrow__img {
  width: 24rpx;
  height: 24rpx;
}

.soar-row__term {
  font-size: 28rpx;
  color: #374151;
}

.soar-row__term--top {
  font-weight: 600;
  color: #111827;
}

.soar-row__pct {
  font-size: 26rpx;
  font-weight: 600;
  color: #fa5151;
}
