<view class="page">
  <view class="hot-content">
    <!-- 搜索日历卡 -->
    <view class="card cal-card">
      <view class="cal-head">
        <text class="section-title">搜索日历</text>
        <text class="cal-hint">近 30 天 · 数字=当天搜索词数</text>
      </view>
      <scroll-view class="cal-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="cal-row">
          <view
            wx:for="{{days}}"
            wx:key="key"
            class="cal-cell {{item.isToday ? 'cal-cell--today' : ''}}"
            data-key="{{item.key}}"
            hover-class="cal-cell--hover"
            bindtap="selectDay">
            <text class="cal-cell__day {{item.isToday ? 'cal-cell__day--today' : ''}}">{{item.label}}</text>
            <text class="cal-cell__count {{item.isToday ? 'cal-cell__count--today' : ''}}">{{item.count}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 今日 TOP -->
    <view class="card top-card">
      <view class="top-head">
        <text class="section-title">今日 TOP</text>
        <text class="top-more">完整榜单 ›</text>
      </view>

      <view wx:if="{{loadingDay}}" class="card-loading">
        <view class="card-loading__spinner"></view>
      </view>

      <block wx:elif="{{topItems.length > 0}}">
        <view
          wx:for="{{topItems}}"
          wx:key="rank"
          class="rank-row"
          data-term="{{item.term}}"
          hover-class="rank-row--hover"
          bindtap="onTapTerm">
          <view class="rank-row__left">
            <view class="rank-box {{index < 3 ? 'rank-box--hot' : 'rank-box--normal'}}">{{item.rank}}</view>
            <text class="rank-row__term">{{item.term}}</text>
          </view>
          <view class="rank-row__right">
            <text class="rank-row__count">{{item.count}}</text>
            <image
              class="rank-row__flame {{index < 3 ? '' : 'rank-row__flame--weak'}}"
              src="{{index < 3 ? flameRed : flameWeak}}"
              mode="aspectFit" />
            <text wx:if="{{item.pct > 0}}" class="rank-row__pct">{{item.pct}}%</text>
          </view>
        </view>
      </block>

      <view wx:elif="{{!hasData}}" class="card-empty">
        <text class="card-empty__text">暂无搜索数据</text>
      </view>
    </view>

    <!-- 飙升榜 -->
    <view class="card soar-card">
      <view class="soar-head">
        <view class="soar-title">
          <image class="soar-title__icon" src="{{flameRed}}" mode="aspectFit" />
          <text class="section-title">飙升榜</text>
        </view>
        <text class="soar-more">查看完整榜单 ›</text>
      </view>

      <block wx:if="{{soarItems.length > 0}}">
        <view
          wx:for="{{soarItems}}"
          wx:key="term"
          class="soar-row {{index === 0 ? 'soar-row--top' : ''}}"
          data-term="{{item.term}}"
          hover-class="rank-row--hover"
          bindtap="onTapTerm">
          <view class="soar-row__left">
            <view class="soar-arrow {{index === 0 ? 'soar-arrow--top' : ''}}">
              <image class="soar-arrow__img" src="{{index === 0 ? arrowRed : arrowGray}}" mode="aspectFit" />
            </view>
            <text class="soar-row__term {{index === 0 ? 'soar-row__term--top' : ''}}">{{item.term}}</text>
          </view>
          <text class="soar-row__pct {{index === 0 ? 'soar-row__pct--top' : ''}}">↑ {{item.pct}}%</text>
        </view>
      </block>

      <view wx:else class="card-empty">
        <text class="card-empty__text">暂无飙升数据</text>
      </view>
    </view>
  </view>
</view>
