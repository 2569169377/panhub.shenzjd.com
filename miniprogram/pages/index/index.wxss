/* ============ 首页 · 搜索（微信绿重构） ============ */

.page {
  min-height: 100vh;
  background: #f7f7f7;
}

/* ---------- 沉浸 Hero ---------- */
.hero {
  background: linear-gradient(180deg, #07c160 0%, #06ad56 100%);
  padding-bottom: 40rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.hero-nav {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.hero-nav__title {
  font-size: 34rpx;
  font-weight: 500;
  color: #ffffff;
}

.hero__body {
  padding: 24rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 品牌行 */
.hero-brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-logo__icon {
  width: 36rpx;
  height: 36rpx;
}

.hero-brand__name {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-brand__badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
  color: #ffffff;
}

.hero__slogan {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 搜索条 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 100rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 0 16rpx 0 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.search-bar__icon {
  width: 36rpx;
  height: 36rpx;
}

.search-bar__input {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  height: 100%;
}

.search-bar__placeholder {
  color: #999999;
}

.search-bar__clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-bar__clear-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-bar__btn {
  width: 136rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #06ad56;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 平台提示行 */
.hero-platforms {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-platforms__text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-platforms__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

/* ---------- 首页态内容 ---------- */
.page-content {
  padding: 32rpx 40rpx calc(240rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 热门搜索卡 */
.hot-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-live {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hot-live__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10b981;
}

.hot-live__text {
  font-size: 22rpx;
  color: #999999;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  font-size: 26rpx;
  color: #374151;
}

.tag--brand {
  background: #e8f8ef;
  color: #07c160;
  font-weight: 500;
}

.tag--hover {
  opacity: 0.8;
}

/* 热搜趋势入口 */
.entry-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
}

.entry-card--hover {
  opacity: 0.85;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #e8f8ef;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-icon__img {
  width: 44rpx;
  height: 44rpx;
}

.entry-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.entry-sub {
  font-size: 24rpx;
  color: #6b7280;
}

.entry-arrow__img {
  width: 32rpx;
  height: 32rpx;
}

/* 覆盖平台 */
.platform-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.platform-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
}

.chip__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.chip__name {
  font-size: 26rpx;
  color: #374151;
}

/* ============ 搜索结果态 ============ */
.result-head {
  background: #f7f7f7;
  padding: 20rpx 40rpx 8rpx;
}

.result-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 92rpx;
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #e5e5e5;
  padding: 0 16rpx 0 32rpx;
}

.result-search__icon {
  width: 36rpx;
  height: 36rpx;
}

.result-search__input {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  height: 100%;
}

.result-search__btn {
  width: 136rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 16rpx;
}

.stats__count {
  font-size: 24rpx;
  color: #6b7280;
}

.stats__time {
  font-size: 22rpx;
  color: #999999;
}

.filters {
  white-space: nowrap;
  width: 100%;
}

.filters__inner {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  font-size: 24rpx;
  color: #374151;
}

.filter-pill--active {
  background: #07c160;
  border-color: #07c160;
  color: #ffffff;
  font-weight: 500;
}

/* 结果列表 */
.result-body {
  padding: 8rpx 40rpx calc(240rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 120rpx 0;
}

.result-loading__spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.result-loading__text {
  font-size: 26rpx;
  color: #6b7280;
}

.group-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-head__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.group-head__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.group-head__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.group-head__count {
  font-size: 22rpx;
  color: #999999;
}

.group-list {
  display: flex;
  flex-direction: column;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-item--hover {
  opacity: 0.75;
}

.result-item__thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-item__play {
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #ffffff;
  margin-left: 4rpx;
}

.result-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.result-item__title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-item__meta {
  font-size: 22rpx;
  color: #6b7280;
}

.result-item__url {
  font-size: 20rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-item__copy {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  background: #e8f8ef;
  color: #07c160;
  font-size: 24rpx;
  font-weight: 500;
}

.group-more {
  text-align: center;
  padding-top: 8rpx;
}

.group-more__text {
  font-size: 24rpx;
  font-weight: 500;
  color: #07c160;
}

/* 空态 / 错误态 */
.empty-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 140rpx 0;
}

.empty-state__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-bottom: 16rpx;
}

.empty-state__title {
  font-size: 30rpx;
  color: #111827;
}

.empty-state__desc,
.error-state__title {
  font-size: 24rpx;
  color: #999999;
}

/* ============ 密码锁浮层 ============ */
.unlock-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.unlock-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.unlock-card__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #e8f8ef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.unlock-card__icon-img {
  width: 48rpx;
  height: 48rpx;
}

.unlock-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.unlock-card__sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.unlock-card__input {
  width: 100%;
  height: 92rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #111827;
  text-align: center;
}

.unlock-card__placeholder {
  color: #999999;
}

.unlock-card__btn {
  width: 100%;
  height: 92rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
