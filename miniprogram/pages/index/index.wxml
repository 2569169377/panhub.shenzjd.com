<view class="page">
  <!-- ============ 沉浸式 Hero（微信绿渐变 + 自定义导航） ============ -->
  <view class="hero">
    <!-- 自定义导航栏（状态栏 + 导航条同色融入） -->
    <view class="hero-nav" style="padding-top:{{statusBarHeight}}px;height:{{navHeight}}px">
      <text class="hero-nav__title">PanHub 搜索</text>
    </view>

    <!-- Hero 主体 -->
    <view class="hero__body">
      <view class="hero-brand">
        <view class="hero-logo">
          <image class="hero-logo__icon" src="{{searchIconWhite}}" mode="aspectFit" />
        </view>
        <text class="hero-brand__name">PanHub</text>
        <view class="hero-brand__badge">网盘聚合</view>
      </view>
      <text class="hero__slogan">一个入口，搜遍全网网盘资源</text>

      <!-- 搜索条 -->
      <view class="search-bar">
        <image class="search-bar__icon" src="{{searchIconBrand}}" mode="aspectFit" />
        <input
          class="search-bar__input"
          value="{{keyword}}"
          placeholder="搜索影视 / 资源 / 文档…"
          placeholder-class="search-bar__placeholder"
          confirm-type="search"
          bindinput="onKeywordChange"
          bindconfirm="onSearch" />
        <view wx:if="{{keyword}}" class="search-bar__clear" bindtap="onClear">
          <image class="search-bar__clear-icon" src="{{clearIcon}}" mode="aspectFit" />
        </view>
        <button class="search-bar__btn" bindtap="onSearch">搜索</button>
      </view>

      <!-- 平台提示行 -->
      <view class="hero-platforms">
        <text class="hero-platforms__text">覆盖 5 大网盘平台</text>
        <view wx:for="{{platformChips}}" wx:key="key" class="hero-platforms__dot" style="background:{{item.color}}"></view>
      </view>
    </view>
  </view>

  <!-- ============ 首页态（未搜索） ============ -->
  <block wx:if="{{!searched}}">
    <view class="page-content">
      <!-- 热门搜索卡 -->
      <view class="card hot-card" wx:if="{{hotTags.length > 0}}">
        <view class="card-head">
          <text class="section-title">热门搜索</text>
          <view class="hot-live">
            <view class="hot-live__dot"></view>
            <text class="hot-live__text">实时更新</text>
          </view>
        </view>
        <view class="tag-wrap">
          <view
            wx:for="{{hotTags}}"
            wx:key="*this"
            class="tag {{index === 0 ? 'tag--brand' : ''}}"
            data-term="{{item}}"
            hover-class="tag--hover"
            bindtap="onQuickSearch">{{item}}</view>
        </view>
      </view>

      <!-- 热搜趋势入口 -->
      <view class="card entry-card" hover-class="entry-card--hover" bindtap="goHot">
        <view class="entry-icon">
          <image class="entry-icon__img" src="{{flameBrand}}" mode="aspectFit" />
        </view>
        <view class="entry-texts">
          <text class="entry-title">热搜趋势</text>
          <text class="entry-sub">飙升榜 · 每日搜索日历</text>
        </view>
        <view class="entry-arrow">
          <image class="entry-arrow__img" src="{{chevronIcon}}" mode="aspectFit" />
        </view>
      </view>

      <!-- 覆盖平台 -->
      <view class="platform-section">
        <text class="section-title">覆盖平台</text>
        <view class="platform-chips">
          <view wx:for="{{platformChips}}" wx:key="key" class="chip">
            <view class="chip__dot" style="background:{{item.color}}"></view>
            <text class="chip__name">{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 搜索结果态 ============ -->
  <block wx:elif="{{searched}}">
    <!-- 顶部搜索条 + 统计 + 筛选 -->
    <view class="result-head">
      <view class="result-search">
        <image class="result-search__icon" src="{{searchIconBrand}}" mode="aspectFit" />
        <input
          class="result-search__input"
          value="{{keyword}}"
          placeholder="搜索网盘资源"
          placeholder-class="search-bar__placeholder"
          confirm-type="search"
          bindinput="onKeywordChange"
          bindconfirm="onSearch" />
        <view wx:if="{{keyword}}" class="search-bar__clear" bindtap="onClear">
          <image class="search-bar__clear-icon" src="{{clearIcon}}" mode="aspectFit" />
        </view>
        <button class="result-search__btn" bindtap="onSearch">搜索</button>
      </view>

      <view wx:if="{{!loading}}" class="stats">
        <text class="stats__count">共 {{total}} 条结果</text>
        <text wx:if="{{elapsedMs > 0}}" class="stats__time">用时 {{elapsedMs}}ms</text>
      </view>

      <scroll-view wx:if="{{hasResults && platforms.length > 0}}" class="filters" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filters__inner">
          <view class="filter-pill {{filterPlatform === 'all' ? 'filter-pill--active' : ''}}" bindtap="setFilter" data-p="all">全部 ({{total}})</view>
          <view
            wx:for="{{platforms}}"
            wx:key="*this"
            class="filter-pill {{filterPlatform === item ? 'filter-pill--active' : ''}}"
            bindtap="setFilter"
            data-p="{{item}}">
            {{platformName(item)}} ({{merged[item].length}})
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 结果列表 -->
    <view class="result-body">
      <view wx:if="{{loading}}" class="result-loading">
        <view class="result-loading__spinner"></view>
        <text class="result-loading__text">搜索中…</text>
      </view>

      <block wx:elif="{{hasResults}}">
        <view wx:for="{{groupedResults}}" wx:key="type" class="card group-card">
          <view class="group-head">
            <view class="group-head__left">
              <view class="group-head__dot" style="background:{{platformColor(item.type)}}"></view>
              <text class="group-head__name">{{platformName(item.type)}}</text>
            </view>
            <text class="group-head__count">{{item.total}} 条</text>
          </view>

          <view class="group-list">
            <block wx:for="{{item.items}}" wx:for-item="link" wx:for-index="linkIndex" wx:key="url">
              <view
                wx:if="{{linkIndex < 3 || expanded[item.type]}}"
                class="result-item"
                hover-class="result-item--hover"
                data-url="{{link.url}}"
                bindtap="onCopyLink">
                <view class="result-item__thumb" style="background:{{platformColor(item.type)}}26">
                  <view class="result-item__play" style="border-left-color:{{platformColor(item.type)}}"></view>
                </view>
                <view class="result-item__body">
                  <text class="result-item__title">{{link.note || link.url}}</text>
                  <text wx:if="{{metaText(link)}}" class="result-item__meta">{{metaText(link)}}</text>
                  <text wx:if="{{link.note && link.url.length > 40}}" class="result-item__url">{{link.url}}</text>
                </view>
                <view class="result-item__copy" catchtap="onCopyLink" data-url="{{link.url}}">复制</view>
              </view>
            </block>
          </view>

          <view
            wx:if="{{item.total > 3}}"
            class="group-more"
            data-type="{{item.type}}"
            bindtap="toggleExpand">
            <text class="group-more__text">{{expanded[item.type] ? '收起' : '查看全部 ' + item.total + ' 条'}}</text>
          </view>
        </view>
      </block>

      <view wx:elif="{{!error}}" class="empty-state">
        <view class="empty-state__icon"></view>
        <text class="empty-state__title">未找到相关资源</text>
        <text class="empty-state__desc">换个关键词试试</text>
      </view>

      <view wx:if="{{error}}" class="error-state">
        <text class="error-state__title">{{error}}</text>
      </view>
    </view>
  </block>

  <!-- ============ 密码锁浮层 ============ -->
  <view wx:if="{{showUnlock}}" class="unlock-mask">
    <view class="unlock-card">
      <view class="unlock-card__icon">
        <image class="unlock-card__icon-img" src="{{lockIcon}}" mode="aspectFit" />
      </view>
      <text class="unlock-card__title">需要密码解锁</text>
      <text class="unlock-card__sub">请输入搜索密码以继续使用</text>
      <input
        class="unlock-card__input"
        password="{{true}}"
        value="{{unlockPwd}}"
        placeholder="搜索密码"
        placeholder-class="unlock-card__placeholder"
        bindinput="onUnlockInput"
        confirm-type="done"
        bindconfirm="onUnlockConfirm" />
      <button class="unlock-card__btn" loading="{{unlocking}}" bindtap="onUnlockConfirm">解锁</button>
    </view>
  </view>
</view>
