/* ============ 设置页（微信绿重构） ============ */

.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.set-content {
  padding: 32rpx 40rpx calc(240rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ---------- 品牌卡 ---------- */
.brand-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.brand-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #07c160 0%, #06ad56 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-logo__icon {
  width: 48rpx;
  height: 48rpx;
}

.brand-texts {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.brand-sub {
  font-size: 24rpx;
  color: #6b7280;
}

/* ---------- 设置项卡 ---------- */
.set-card {
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
}

.set-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
}

.set-item--hover {
  background: #fafafa;
}

.set-item__left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.set-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-icon__img {
  width: 32rpx;
  height: 32rpx;
}

.set-item__title {
  font-size: 28rpx;
  color: #111827;
}

.set-item__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.set-item__note {
  font-size: 24rpx;
  color: #999999;
}

.set-chevron {
  width: 28rpx;
  height: 28rpx;
}

.set-switch {
  transform: scale(0.9);
}

.set-divider {
  height: 1rpx;
  background: #f5f5f5;
  margin-left: 112rpx;
}

.set-footer {
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  padding: 24rpx 0;
}

/* ---------- 解锁弹窗 ---------- */
.unlock-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.unlock-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.unlock-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.unlock-card__sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.unlock-card__input {
  width: 100%;
  height: 92rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #111827;
  text-align: center;
}

.unlock-card__placeholder {
  color: #999999;
}

.unlock-card__btn {
  width: 100%;
  height: 92rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.unlock-card__cancel {
  font-size: 26rpx;
  color: #999999;
  padding: 12rpx 40rpx;
}
