<view class="tab-bar">
  <view class="tab-bar__inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab">
      <image
        class="tab-item__icon"
        src="{{selected === index ? item.iconOn : item.iconOff}}"
        mode="aspectFit" />
      <text class="tab-item__label {{selected === index ? 'tab-item__label--active' : ''}}">{{item.text}}</text>
    </view>
  </view>
</view>
